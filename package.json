{
  "name": "bloom-marketing-prototype",
  "version": "0.7.0",
  "private": true,
  "description": "브랜드 광고 제작 워크스페이스",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.app.json && tsc -p tsconfig.admin.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.admin.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "ops:check": "npm run build && node --env-file-if-exists=.env dist/scripts/check-ops.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "type": "module"
}
