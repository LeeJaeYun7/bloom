# Operator configuration; users never enter these values in Bloom.
# Configure at http://localhost:4174/admin or copy this to .env (ignored by Git).
# Values saved in the operator screen take precedence over environment variables.
# Node.js >=22.9 loads .env with npm start.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# HTTPS origin registered in Meta. Only /auth/instagram/* is accepted there.
# Register this exact callback: https://your-auth-domain.example/auth/instagram/callback
INSTAGRAM_PUBLIC_ORIGIN=
INSTAGRAM_API_VERSION=v27.0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Base64 32-byte AES key. If omitted, Bloom creates a local key in .bloom/.
BLOOM_TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4174

# Optional video renderer overrides; defaults use ffmpeg-static and bundled Noto Sans KR.
FFMPEG_PATH=
BLOOM_VIDEO_FONT=
